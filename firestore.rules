rules_version = '2';

/* ============================================================
   DENNER BARBEARIA — Regras de segurança do Firestore
   ------------------------------------------------------------
   Como aplicar:
   1) Firebase Console > Firestore Database > Regras
   2) Cole o conteúdo deste arquivo e clique em "Publicar"
   (ou use a Firebase CLI: firebase deploy --only firestore:rules)

   Papéis:
   - Documento em /admins/{uid}  → esse uid é administrador
   - Documento em /barbers/{uid} → esse uid é o login de um barbeiro
     (o ID do documento É o UID do barbeiro no Firebase Auth)
   - Qualquer outro usuário autenticado (anônimo) é um CLIENTE
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isBarber() {
      return isSignedIn() && exists(/databases/$(database)/documents/barbers/$(request.auth.uid));
    }
    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /* --- papéis --- */
    match /system/setup {
      // Documento único que controla se o PIN do admin já foi criado.
      // Depois de usado uma vez, fecha sozinho (adminCreated vira true
      // e nunca mais pode voltar a false por regra).
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['adminCreated'])
                    && request.resource.data.adminCreated == false;
      allow update: if isSignedIn()
                    && resource.data.adminCreated == false
                    && request.resource.data.adminCreated == true
                    && onlyFieldsChanged(['adminCreated']);
      allow delete: if false;
    }
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Só permite criar o PRIMEIRO administrador, e só com a conta de
      // e-mail fixa usada pelo PIN (definida em firebase-config.js).
      // Depois que existir um admin, essa porta se fecha sozinha.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.auth.token.email == 'admin@dennerbarbearia.internal'
                    && exists(/databases/$(database)/documents/system/setup)
                    && get(/databases/$(database)/documents/system/setup).data.adminCreated == false;
      allow update, delete: if false;
    }
    match /barbers/{uid} {
      allow read: if true; // lista pública de barbeiros ativos
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /clients/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    /* --- catálogo público (serviços, fotos, config, agenda) --- */
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /businessSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blockedTimes/{id} {
      allow read: if true; // necessário p/ calcular horários disponíveis
      allow create: if isAdmin() || (isBarber() && request.resource.data.barberId == request.auth.uid);
      allow update, delete: if isAdmin() || (isBarber() && resource.data.barberId == request.auth.uid);
    }
    match /daysOff/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* --- agendamentos --- */
    match /appointments/{id} {
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.clientUid == request.auth.uid);

      // Leitura liberada para qualquer usuário autenticado (inclusive
      // anônimo, ou seja, qualquer cliente do site). É necessário para
      // o cliente conseguir checar quais horários já estão ocupados de
      // OUTRAS pessoas antes de agendar (o Firestore não permite provar,
      // numa busca por barbeiro/data, que o resultado pertence só a
      // quem está pedindo — então a regra não pode depender do dono).
      // Trade-off: nome e telefone do cliente ficam visíveis para
      // qualquer pessoa que soubesse consultar o banco diretamente
      // (não aparecem na tela de ninguém além do dono/barbeiro/admin —
      // é só uma questão de regra de acesso, não de exibição).
      allow read: if isSignedIn();

      allow update: if isAdmin() ||
        // cliente só pode cancelar o próprio agendamento
        (isSignedIn() && resource.data.clientUid == request.auth.uid &&
          request.resource.data.status == 'cancelled' && onlyFieldsChanged(['status'])) ||
        // barbeiro só pode concluir/cancelar os próprios atendimentos
        (isBarber() && resource.data.barberId == request.auth.uid &&
          request.resource.data.status in ['completed','cancelled'] && onlyFieldsChanged(['status']));

      allow delete: if isAdmin();
    }

    /* --- notificações (estrutura preparada para uso futuro) --- */
    match /notifications/{id} {
      allow read: if isAdmin() || (isBarber() && resource.data.barberId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
